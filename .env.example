# --- Platform authentication (REQUIRED in production) ---
# Set in Railway Variables — never commit real values to git.
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_strong_password
# Standard users with hashed passwords (config/auth_users.json). Optional override:
# AUTH_USERS_PATH=config/auth_users.json
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SESSION_SECRET=replace_with_64_char_hex_secret_minimum_32_chars
# true on Railway (HTTPS); false for local http://127.0.0.1
AUTH_COOKIE_SECURE=false
SESSION_INACTIVITY_MINUTES=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=30
# Local only: allow ephemeral session secret if AUTH_SESSION_SECRET unset
# AUTH_ALLOW_DEV_DEFAULTS=false
# Raw seller debug API (disabled by default in production)
# ENABLE_SELLER_DEBUG_ENDPOINT=false

ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5
HEADLESS=0
# Shopee catalog sync — public HTTP API (local only, not Railway)
# Optional: paste Cookie header from browser DevTools if API returns error 90309999
# SHOPEE_API_COOKIE=
# SHOPEE_API_EXTRA_HEADERS={"af-ac-enc-dat":"...","x-sap-ri":"..."}
# Local catalog JSON: data/shopee_catalogs/{shop_id}.json
# Test: python scripts/test_shopee_api_mumu_ph.py
# Sync: python scripts/sync_shopee_catalogs_local.py --shop-id 19100527
DEBUG=1
MAX_SOURCES=5
SEARCH_TIMEOUT_MS=10000
FETCH_TIMEOUT_MS=10000
CLAUDE_TIMEOUT_SEC=30
EXCERPT_MAX_CHARS=4500

# --- Seller Intelligence V1 ---
USD_PHP_RATE=61.55

# FastMoss shop matching (multi-keyword search on Update Data)
# FASTMOSS_MAPPED_MIN_SCORE=0.68
# INTELLIGENCE_AUTO_SYNC_ON_STARTUP=true
# INTELLIGENCE_SYNC_MAX_AGE_HOURS=24
# INTELLIGENCE_BOOTSTRAP_DELAY_SEC=3
# When UI MTD/M-1 period chips change, auto re-fetch FastMoss TikTok ADGMV (default true)
# INTELLIGENCE_AUTO_REFRESH_ON_PERIOD_CHANGE=true
# Daily BI cache refresh (Asia/Manila calendar day). Default 16:05 UTC = 00:05 PH.
# BI_DAILY_REFRESH_ENABLED=true
# BI_DAILY_REFRESH_HOUR_UTC=16
# BI_DAILY_REFRESH_MINUTE_UTC=5
# BI_DAILY_REFRESH_STARTUP_DELAY_SEC=8
# BUSINESS_TIMEZONE=Asia/Manila
# FASTMOSS_REVIEW_MIN_SCORE=0.38
# FASTMOSS_WEAK_REVIEW_MIN_SCORE=0.30
# FASTMOSS_AMBIGUOUS_GAP=0.08
# FASTMOSS_MATCH_MAX_KEYWORDS=12
#
# --- FastMoss JSON API (Seller Level Analysis TikTok ADGMV) ---
# Uses the same shop recentData endpoint the FastMoss web app calls.
# Do NOT scrape the HTML homepage — that triggers WAF 502.
# FASTMOSS_API_BASE_URL=https://www.fastmoss.com
# FASTMOSS_BASE_URL=https://www.fastmoss.com
# Optional official-style auth (if FastMoss issues them to you):
# FASTMOSS_ACCESS_TOKEN=
# FASTMOSS_API_KEY=
# Session cookie from a logged-in browser (backend only — never expose to frontend):
# FASTMOSS_COOKIE=session_id=...; token=...;
# Or local file (gitignored):
# FASTMOSS_COOKIE_FILE=credentials/fastmoss_cookie.txt
# FASTMOSS_REGION=PH
# FASTMOSS_REQUEST_TIMEOUT_MS=30000
# FASTMOSS_REQUEST_TIMEOUT_SEC=30
# FASTMOSS_MAX_CONCURRENCY=3
# FASTMOSS_RETRY_COUNT=3
# FASTMOSS_REQUEST_DELAY_MIN_SEC=1.0
# FASTMOSS_REQUEST_DELAY_MAX_SEC=3.0
# FASTMOSS_HEALTHCHECK_SHOP_ID=7494600626141628535
# Diagnostic (no secrets in output):
#   python scripts/test_fastmoss_api.py --shop-id=<FAST_MOSS_SHOP_ID>
# Health: GET /api/intelligence/v1/business/fastmoss-health
#
# Committed BI seed used when runtime cache is wiped mid-refresh:
# BUSINESS_INTELLIGENCE_SEED_PATH=business_intelligence_data.seed.json

# --- Seller Dashboard: Google Sheets (mirror, Service Account) ---
# See GOOGLE_SHEETS_SETUP.md. Keep ENABLED=false until live connection is approved.
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEET_MIRROR_ID=1uhq7vJqLSDbckeLHf2SxEjEloMHb-xLa8YimGCs9Eyk
# Local dev: path to JSON key (gitignored under credentials/)
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/service-account.json
# Railway: paste full Service Account JSON as one line (do not use both path and JSON in prod)
# GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_SHEET_PRIMARY_TAB=AI data
# Seller Intelligence V1 master list tab (columns: Shop ID, Shop Name, Shopee Link, TikTok Shop Name)
GOOGLE_SHEET_SELLER_MASTER_TAB=shpoee link
# Seller Level Analysis RM filter (columns A=RM, B=GP NAME, C=SHOP NAME)
GOOGLE_SHEET_GP_SHOP_RM_TAB=GP SHOP AND RM RAW
# GP SHOP AND RM RAW cache TTL (seconds). Default 300 = 5 minutes.
# GP_SHOP_RM_CACHE_TTL_SEC=300
# Seller Master in-memory cache TTL (seconds). Default 300 = 5 minutes.
SELLER_MASTER_CACHE_TTL_SEC=300
# Shopee ADGMV Tracker tab (columns: shop_name, mtd_adgmv_usd, m_1_adgmv_usd)
GOOGLE_SHEET_SHOPEE_ADGMV_TAB=shopee adgmv raw data
# Historical SOB — YTD monthly Shopee ADGMV (shop_name, shop_id, ytd_apr_adgmv, ytd_may_adgmv)
GOOGLE_SHEET_YTD_MONTHLY_TAB=ytd monthly data
# TikTok Product Radar — shop list from seller master tab; products from FastMoss goods API
# pagesize above 10 causes FastMoss /api/shop/v3/goods HTTP 400 (value is capped in code)
ASSORTMENT_RADAR_PAGE_SIZE=10
ASSORTMENT_RADAR_MAX_PRODUCTS=1000
# Cached FastMoss May/June TikTok GMV (writable runtime file)
# HISTORICAL_SOB_CACHE_PATH=historical_sob_cache.json
# Committed seed used when runtime cache is empty/wiped (do not overwrite daily)
# HISTORICAL_SOB_SEED_PATH=historical_sob_cache.seed.json
# HISTORICAL_SOB_AUTO_REFRESH_ON_STARTUP=true
GOOGLE_SHEETS_CONNECT_ON_STARTUP=false
